[core]
	editor = vim
	excludesfile = ~/.gitignore

[alias]
	co = checkout
	br = branch
	ci = commit -a
	st = status -s -uno
	lg = log --stat
	# push the current branch, setting upstream
	pub = "!f() { git push -u ${1:-origin} `git symbolic-ref HEAD`; }; f"
	# push the current branch to origin (after upstream is set)
	pushup = !git push origin $(git rev-parse --abbrev-ref HEAD)

# Per-machine identity / overrides go in ~/.gitconfig.local
# Example:
#   [user]
#       name  = Your Name
#       email = you@example.com
#   [credential]
#       helper = osxkeychain
[include]
	path = ~/.gitconfig.local
